#include <stdbool.h>

int getNextIndex(int* nums, int numsSize, int i) {
    int next = (i + nums[i]) % numsSize;
    if (next < 0) {
        next += numsSize;
    }
    return next;
}

bool circularArrayLoop(int* nums, int numsSize) {
    if (numsSize < 2) return false;

    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == 0) continue;

        int slow = i;
        int fast = i;
        bool isForward = nums[i] > 0;

        while (true) {
            int nextSlow = getNextIndex(nums, numsSize, slow);
            if ((nums[nextSlow] > 0) != isForward || nums[nextSlow] == 0) break;
            slow = nextSlow;

            int nextFast1 = getNextIndex(nums, numsSize, fast);
            if ((nums[nextFast1] > 0) != isForward || nums[nextFast1] == 0) break;
            
            int nextFast2 = getNextIndex(nums, numsSize, nextFast1);
            if ((nums[nextFast2] > 0) != isForward || nums[nextFast2] == 0) break;
            fast = nextFast2;

            if (slow == fast) {
                if (slow == getNextIndex(nums, numsSize, slow)) {
                    break; 
                }
                return true;
            }
        }

        int curr = i;
        while (true) {
            int next = getNextIndex(nums, numsSize, curr);
            if ((nums[curr] > 0) != isForward || nums[curr] == 0) break;
            nums[curr] = 0;
            curr = next;
        }
    }

    return false;
}

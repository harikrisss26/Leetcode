import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<String> readBinaryWatch(int turnedOn) {
        List<String> result = new ArrayList<>();
        int[] LEDs = new int[]{8, 4, 2, 1, 32, 16, 8, 4, 2, 1};
        backtrack(turnedOn, 0, 0, 0, LEDs, result);
        return result;
    }

    private void backtrack(int turnedOn, int index, int hr, int min, int[] LEDs, List<String> result) {
        if (hr >= 12 || min >= 60) {
            return;
        }
        if (turnedOn == 0) {
            result.add(String.format("%d:%02d", hr, min));
            return;
        }
        for (int i = index; i < LEDs.length; i++) {
            if (i < 4) {
                backtrack(turnedOn - 1, i + 1, hr + LEDs[i], min, LEDs, result);
            } else {
                backtrack(turnedOn - 1, i + 1, hr, min + LEDs[i], LEDs, result);
            }
        }
    }
}
